[Unit]
Description=sysmon agent (telemetria read-only)
Documentation=https://github.com/SEU_USUARIO/sysmon
After=network-online.target
Wants=network-online.target
# Erro de configuracao nao pode virar loop de restart infinito.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# notify: o systemd so considera o servico ativo depois da primeira coleta.
Type=notify
NotifyAccess=main
# __BIND_IP__ e trocado pelo install.sh. Nunca 0.0.0.0 se o host tiver IP publico.
ExecStart=/opt/sysmon/sysmon-agent --host __BIND_IP__ --port __PORT__ --intervalo 5s
EnvironmentFile=/etc/sysmon/token.env

# O agente e IO-bound e trivial. Sem isso o Go dimensiona o scheduler pelo
# numero de CPUs do host, o que num servidor de 64 nucleos e desperdicio puro.
Environment=GOMAXPROCS=2

# Watchdog: o agente so manda o pulso depois de uma coleta bem-sucedida. Se a
# coleta travar, o systemd reinicia sozinho - antes, um agente vivo servindo
# dado congelado passava despercebido.
WatchdogSec=60

# O unico lugar gravavel do servico: a serie temporal dos contadores SMART,
# que precisa sobreviver a reinicio para que "quanto mudou em 30 dias" tenha
# resposta. Com DynamicUser, o systemd cria, chowna e mantem isso sozinho.
StateDirectory=sysmon
StateDirectoryMode=0700

# --- Hardening: o agente so precisa LER sysfs e procfs ---
DynamicUser=yes
# Necessario apenas para a contagem de VMs/CTs em /etc/pve/.vmlist (Proxmox).
# Em host que nao e Proxmox, o install.sh remove esta linha.
SupplementaryGroups=www-data
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_UNIX e exigido pelo sd_notify (watchdog); AF_INET/INET6 pelo proprio HTTP.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0077

# Isso jamais deve competir com as VMs.
MemoryMax=64M
CPUQuota=5%
TasksMax=32
Nice=10
IOSchedulingClass=idle

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
